<resources>
    <!-- Base Application Theme -->
    <style name="Theme.LarkPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Secondary Brand Colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Tertiary Colors -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorTertiaryVariant">@color/tertiary_variant</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>

        <!-- Surface Colors -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Background Colors -->
        <item name="colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>

        <!-- Error Colors -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Scrim -->
        <item name="colorScrim">@color/scrim</item>

        <!-- Inverse -->
        <item name="colorInverseSurface">@color/inverse_surface</item>
        <item name="colorInverseOnSurface">@color/inverse_on_surface</item>
        <item name="colorInversePrimary">@color/inverse_primary</item>

        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.LarkPlayer.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.LarkPlayer.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.LarkPlayer.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.LarkPlayer.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.LarkPlayer.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.LarkPlayer.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.LarkPlayer.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.LarkPlayer.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.LarkPlayer.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.LarkPlayer.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.LarkPlayer.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.LarkPlayer.LabelSmall</item>

        <!-- Shape Appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.LarkPlayer.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.LarkPlayer.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.LarkPlayer.LargeComponent</item>
    </style>

    <!-- Player Fullscreen Theme -->
    <style name="Theme.LarkPlayer.Player" parent="Theme.LarkPlayer">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Dialog Theme -->
    <style name="Theme.LarkPlayer.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
    </style>

    <!-- Bottom Sheet Theme -->
    <style name="Theme.LarkPlayer.BottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.LarkPlayer.BottomSheet</item>
    </style>

    <style name="Widget.LarkPlayer.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.LarkPlayer.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.LarkPlayer.BottomSheet" parent="ShapeAppearance.Material3.BottomSheet">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <style name="ShapeAppearance.LarkPlayer.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent" />
    <style name="ShapeAppearance.LarkPlayer.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent" />
    <style name="ShapeAppearance.LarkPlayer.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent" />

    <style name="TextAppearance.LarkPlayer.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge" />
    <style name="TextAppearance.LarkPlayer.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium" />
    <style name="TextAppearance.LarkPlayer.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall" />
    <style name="TextAppearance.LarkPlayer.TitleLarge" parent="TextAppearance.Material3.TitleLarge" />
    <style name="TextAppearance.LarkPlayer.TitleMedium" parent="TextAppearance.Material3.TitleMedium" />
    <style name="TextAppearance.LarkPlayer.TitleSmall" parent="TextAppearance.Material3.TitleSmall" />
    <style name="TextAppearance.LarkPlayer.BodyLarge" parent="TextAppearance.Material3.BodyLarge" />
    <style name="TextAppearance.LarkPlayer.BodyMedium" parent="TextAppearance.Material3.BodyMedium" />
    <style name="TextAppearance.LarkPlayer.BodySmall" parent="TextAppearance.Material3.BodySmall" />
    <style name="TextAppearance.LarkPlayer.LabelLarge" parent="TextAppearance.Material3.LabelLarge" />
    <style name="TextAppearance.LarkPlayer.LabelMedium" parent="TextAppearance.Material3.LabelMedium" />
    <style name="TextAppearance.LarkPlayer.LabelSmall" parent="TextAppearance.Material3.LabelSmall" />
</resources>